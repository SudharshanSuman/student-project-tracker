# ── Database ──────────────────────────────────────────────
# Local dev without Docker: `npm run db:start` (embedded PostgreSQL on 5433).
# Docker Compose: postgresql://iic:iic@localhost:5432/iic
DATABASE_URL=postgresql://iic:iic_dev_password@localhost:5433/iic_dev
TEST_DATABASE_URL=postgresql://iic:iic_dev_password@localhost:5433/iic_test

# ── API server ────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Browser origin(s) allowed by CORS / CSRF origin check (comma separated)
WEB_ORIGIN=http://localhost:3000
# Public URL used in emails (password reset, invitations)
APP_URL=http://localhost:3000
# Comma separated institutional email domains. Empty = allow any domain (dev only).
INSTITUTION_EMAIL_DOMAINS=karunya.edu.in,karunya.edu
# Identifier printed on reports
INSTITUTION_ID=KARUNYA-IIC
SESSION_TTL_HOURS=72
# HMAC secret for signed QR attendance tokens (>= 32 chars). Generate: openssl rand -hex 32
QR_TOKEN_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where uploaded documents and generated reports are stored (outside the web root)
STORAGE_DIR=./storage

# ── Email (optional). If SMTP_HOST is empty, emails are written to the API log. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IIC Platform <no-reply@example.edu>"

# ── Web (Next.js) ─────────────────────────────────────────
# Where the Next.js server reaches the API (server-side + /api rewrite proxy)
API_INTERNAL_URL=http://localhost:4000
# Browser WebSocket endpoint for live hints (notifications/board). Optional.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# ── Integrations (Phase 4; leave blank until credentials exist) ──
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
GITHUB_TOKEN=
REDIS_URL=

# ── PDF reports (Puppeteer) ───────────────────────────────
# Chrome/Chromium binary. Empty = auto-detect /usr/bin/google-chrome(-stable), /usr/bin/chromium(-browser).
PUPPETEER_EXECUTABLE_PATH=
# Only for containers running as root without the Chrome sandbox.
PUPPETEER_NO_SANDBOX=false
# Browser pool size = max PDFs rendered at once (bounded Chromium processes).
REPORT_CONCURRENCY=2
REPORT_MAX_ATTEMPTS=3
# Generated PDFs are deleted and downloads refused after this many days.
REPORT_RETENTION_DAYS=30
# Run the background report worker inside the API process.
REPORT_WORKER=true
# Attendance rate (percent) below which participants are flagged in compliance reports.
ATTENDANCE_COMPLIANCE_THRESHOLD=75
